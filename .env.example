# Telegram Bot konfiguracija
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_optional_admin_chat_id_here

# Putanja do SQLite baze podataka
DB_PATH=data/listings.db

# Interval automatskog skrepanja (u minutama)
SCRAPE_INTERVAL_MINUTES=30

# Putanja do spremljene Facebook sesije (kolačići / storage state)
FACEBOOK_STORAGE_STATE=facebook_state.json

# (Opcionalno) Telegram Mini App URL za interaktivnu kartu
WEBAPP_URL=https://vas-username.github.io/stanovi-osijek-bot/webapp/

# (Opcionalno) Google Gemini API ključ za AI ekstrakciju režija, pologa i sažetaka
GEMINI_API_KEY=your_gemini_api_key_here
